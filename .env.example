# Copy this to .env and fill in your values
# NEVER commit .env to git

# ── HuggingFace API (FREE — powers both embeddings AND LLM) ───────
# Get your free token: https://huggingface.co/settings/tokens (Read access)
HF_API_KEY=hf_...

# ── Paid APIs (optional, for local dev) ────────────────────────────
# OpenAI
OPENAI_API_KEY=sk-...

# Bytez
BYTEZ_API_KEY=your-bytez-key

# ── Provider selection ─────────────────────────────────────────────
# LLM: huggingface | openai | bytez
LLM_PROVIDER=huggingface
LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Embeddings: huggingface | local | openai | bytez
EMBEDDING_PROVIDER=huggingface

# App
DEBUG=false

# Embedding model
# Options: BAAI/bge-large-en-v1.5 | BAAI/bge-base-en-v1.5 | sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# ChromaDB
CHROMA_PERSIST_DIRECTORY=./chroma_store
CHROMA_COLLECTION_NAME=documents

# Upload limits
MAX_UPLOAD_SIZE_MB=20
