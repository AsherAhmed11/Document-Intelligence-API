# ── Google Gemini API (FREE tier — used for BOTH embeddings AND LLM) ──────────
# Get yours free at: https://aistudio.google.com/apikey (30 seconds, no card)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Active providers ───────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

# ── App ────────────────────────────────────────────────────────────────────────
DEBUG=false

# ── ChromaDB ───────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIRECTORY=./chroma_store
CHROMA_COLLECTION_NAME=documents

# ── Upload limits ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20

# ── Legacy (not needed — kept for reference only) ─────────────────────────────
# OPENAI_API_KEY=...
# HF_API_KEY=...
